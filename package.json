    "import:tn": "node scripts/import-national.mjs tn --current",
    "data:update": "node scripts/update-data.mjs",
    "data:watch": "node scripts/data-worker.mjs",
    "media:update": "node scripts/import-videos.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.2.8",
    "@serwist/cli": "9.5.15",
    "@serwist/next": "9.5.15",
    "idb": "8.0.3",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serwist": "9.5.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@netlify/plugin-nextjs": "5.16.8",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cheerio": "1.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
